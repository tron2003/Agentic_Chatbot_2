# Copy to .env and fill in what you use. Never commit .env.

# ── Runtime ─────────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development (reload, text logs) | production (JSON logs)
LOG_LEVEL=INFO

# ── Language model ──────────────────────────────────────────────────────────
# claude | openai | openrouter | ollama | local | demo  (demo needs no key)
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_ROUTER_MODEL=claude-haiku-5-5   # cheaper model for routing, titles, summaries
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:4b

# ── Tools ───────────────────────────────────────────────────────────────────
TAVILY_API_KEY=                  # best web search for the Research route
# WEB_SEARCH_PROVIDER=auto       # auto (Tavily, else DuckDuckGo, no key) | tavily | duckduckgo | off
GITHUB_TOKEN=                    # enables the GitHub MCP server
ENABLE_MCP=true                  # MCP servers need Node.js (npx) installed

# ── Embeddings (document library) ───────────────────────────────────────────
EMBEDDING_PROVIDER=ollama        # ollama | openai
# OLLAMA_EMBED_MODEL=qwen3-embedding:4b

# ── Storage ─────────────────────────────────────────────────────────────────
# Without DB_URI everything is kept in memory (fine for trying it out).
# With Postgres + pgvector, conversations, memory and documents persist.
DB_URI=postgresql://chatbot:change-me@localhost:5432/chatbot
# VECTOR_DB_URI=                 # defaults to DB_URI

# ── HTTP and security ───────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_KEYS=                        # comma-separated; when set, every /api call needs one
RATE_LIMIT_PER_MINUTE=30         # per key or IP, for chat and uploads
MAX_UPLOAD_MB=25
MAX_MESSAGE_CHARS=16000

# ── Integrations (optional, all off by default; see docs/integrations.md) ──
# Junction delegates tasks to OpenClaw (tool: ask_openclaw)
OPENCLAW_ENABLED=false
OPENCLAW_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
# OPENCLAW_AGENT=openclaw/default
# OpenClaw announces Junction events via its /hooks/agent webhook
OPENCLAW_HOOKS_ENABLED=false
OPENCLAW_HOOKS_TOKEN=
# Junction delegates tasks to Hermes Agent (tool: ask_hermes)
HERMES_ENABLED=false
HERMES_URL=http://127.0.0.1:8642
HERMES_API_KEY=
# Other apps use Junction as their model: http://<host>:8001/v1, model "junction"
ENABLE_OPENAI_API=false
OPENAI_API_KEYS=
# Junction as an MCP server at /mcp
ENABLE_MCP_SERVER=false
MCP_SERVER_API_KEYS=
# Signed JSON webhooks (n8n, Zapier, …)
WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_SECRET=
